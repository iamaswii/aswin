/* ==========================================================================
   GreenSpace Landing Page CSS Stylesheet
   Designed for: Premium, modern dark aesthetic, rich micro-animations,
                 responsive layouts, and polished glassmorphism elements.
   ========================================================================== */
/* 1. Design Tokens & Root Variables */
:root {
  --color-bg-dark: hsl(140, 10%, 6%);
  --color-bg-card: rgba(255, 255, 255, 0.02);
  --color-bg-card-hover: rgba(255, 255, 255, 0.05);
  
  /* Green Accents */
  --color-primary: hsl(142, 60%, 45%);
  --color-primary-glow: hsla(142, 60%, 45%, 0.35);
  --color-primary-dark: hsl(142, 70%, 25%);
  --color-accent-light: hsl(142, 50%, 80%);
  
  /* Typography Colors */
  --color-text-primary: hsl(0, 0%, 95%);
  --color-text-secondary: hsl(140, 6%, 70%);
  --color-text-muted: hsl(140, 4%, 48%);
  
  /* Borders and Glass */
  --glass-border: 1px solid rgba(255, 255, 255, 0.05);
  --glass-border-hover: 1px solid rgba(255, 255, 255, 0.12);
  --glass-glow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
  --glass-blur: blur(16px);
  
  /* Fonts */
  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --font-header: 'Syne', sans-serif;
  
  /* Animations & Transitions */
  --transition-smooth: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  --transition-fast: all 0.25s ease;
}
/* 2. Global Resets & Base Styles */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  cursor: none; /* Hide standard cursor for premium custom cursor experience */
}
@media (max-width: 1024px) {
  * {
    cursor: auto !important; /* Enable standard cursor on touch devices */
  }
}
html {
  scroll-behavior: smooth;
  font-size: 16px;
  background-color: var(--color-bg-dark);
  color: var(--color-text-primary);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
}
body {
  overflow-x: hidden;
  position: relative;
  min-height: 100vh;
}
/* Custom Premium Scrollbar */
::-webkit-scrollbar {
  width: 8px;
}
::-webkit-scrollbar-track {
  background: var(--color-bg-dark);
}
::-webkit-scrollbar-thumb {
  background: var(--color-primary-dark);
  border-radius: 4px;
  border: 2px solid var(--color-bg-dark);
  transition: var(--transition-fast);
}
::-webkit-scrollbar-thumb:hover {
  background: var(--color-primary);
}
/* 3. Ambient Glow Lights */
.glow-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(120px);
  pointer-events: none;
  z-index: 0;
  opacity: 0.15;
  mix-blend-mode: screen;
}
.glow-1 {
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%);
  top: -100px;
  right: -50px;
  animation: orbSway 15s ease-in-out infinite alternate;
}
.glow-2 {
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, var(--color-primary-dark) 0%, transparent 70%);
  top: 50%;
  left: -200px;
  animation: orbSway 20s ease-in-out infinite alternate-reverse;
}
.glow-3 {
  width: 450px;
  height: 450px;
  background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%);
  bottom: -100px;
  right: 10%;
}
@keyframes orbSway {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(50px, 30px) scale(1.15); }
}
/* 4. Canvas Particle Overlay */
.leaf-canvas {
