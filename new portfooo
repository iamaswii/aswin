  }
  // Create particle pool
  const leafCount = 20;
  const leaves = Array.from({ length: leafCount }, () => new LeafParticle());
  function animateLeaves() {
    if (ctx) {
      ctx.clearRect(0, 0, width, height);
      leaves.forEach(leaf => {
        leaf.update();
        leaf.draw();
      });
    }
    requestAnimationFrame(animateLeaves);
  }
  animateLeaves();
  // ==========================================
  // 4. 3D POTTED PLANT CARD TILT (HERO ELEMENT)
  // ==========================================
  const plantCard = document.getElementById('heroPlantCard');
  if (plantCard) {
    plantCard.addEventListener('mousemove', (e) => {
      const rect = plantCard.getBoundingClientRect();
      // Mouse coordinates relative to card center (normalized between -0.5 and 0.5)
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;
      
      // Calculate tilt limits
      const maxTiltX = 12; // tilt degrees up/down
      const maxTiltY = 12; // tilt degrees left/right
      
      const tiltX = -y * maxTiltX;
      const tiltY = x * maxTiltY;
      // Apply transform styles
      plantCard.style.transform = `rotateX(${tiltX}deg) rotateY(${tiltY}deg) scale(1.025)`;
      
      // Send mouse coordinates to css properties for glossy spotlight tracking
      const localX = e.clientX - rect.left;
      const localY = e.clientY - rect.top;
      plantCard.style.setProperty('--mouse-x', `${localX}px`);
      plantCard.style.setProperty('--mouse-y', `${localY}px`);
    });
    plantCard.addEventListener('mouseleave', () => {
      // Revert smoothly to flat alignment
      plantCard.style.transform = `rotateX(0deg) rotateY(0deg) scale(1)`;
    });
  }
  // ==========================================
  // 5. HIGH-PERFORMANCE SCROLL PARALLAX ENGINE
  // ==========================================
  const heroBg = document.getElementById('heroBg');
  const botanicalStem = document.getElementById('botanicalStem');
  const header = document.getElementById('header');
  
  let lastScrollY = 0;
  let ticking = false;
  function updateParallax(scrollY) {
    // Parallax on hero foliage background layer
    if (heroBg) {
      // Moves slower than background to create layered depth
      heroBg.style.transform = `translateY(${scrollY * 0.35}px)`;
    }
    // Scroll-bound shift and organic rotation on footer botanical overlay stem
    if (botanicalStem) {
      const offset = (scrollY - botanicalStem.offsetTop) * 0.15;
      botanicalStem.style.transform = `translateY(${offset}px) rotate(${offset * 0.03}deg)`;
    }
    // Header compression shrink
    if (header) {
      if (scrollY > 50) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    }
  }
  window.addEventListener('scroll', () => {
    lastScrollY = window.scrollY;
    
    // Throttle scroll events to requestAnimationFrame for high-performance rendering
    if (!ticking) {
      window.requestAnimationFrame(() => {
        updateParallax(lastScrollY);
        ticking = false;
      });
      ticking = true;
    }
  });
  // ==========================================
  // 6. INTERSECTION OBSERVER FOR FADE REVEALS
  // ==========================================
  const revealElements = document.querySelectorAll('.animate-on-scroll');
  
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.12 // Trigger when 12% of card is in screen
  };
  const observer = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('revealed');
        // Once revealed, no need to keep observing
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);
  revealElements.forEach(el => observer.observe(el));
  // ==========================================
  // 7. PREMIUM MODAL SYSTEMS & CATALOG ACTION
  // ==========================================
  
  // Modals DOM references
  const catalogModal = document.getElementById('catalogModal');
  const videoModal = document.getElementById('videoModal');
  const showcaseVideo = document.getElementById('showcaseVideo');
  const videoWrapper = document.querySelector('.video-wrapper');
  
  // Triggers DOM references
  const openCatalogBtns = [
    document.getElementById('openCatalogBtn'),
    document.getElementById('openCatalogBtnHeader'),
    document.getElementById('openCatalogBtnFooter')
  ];
  const closeCatalogBtn = document.getElementById('closeCatalogBtn');
  const playVideoBtn = document.getElementById('playVideoBtn');
  const officeShowcase = document.getElementById('officeShowcase');
  const closeVideoBtn = document.getElementById('closeVideoBtn');
  // Generic helper to open any modal
  function openModal(modal) {
    modal.classList.add('active');
    document.body.style.overflow = 'hidden'; // Lock background scrolling
  }
  // Generic helper to close any modal
  function closeModal(modal) {
    modal.classList.remove('active');
    document.body.style.overflow = ''; // Unlock scrolling
  }
  // Bind catalog triggers
  openCatalogBtns.forEach(btn => {
    if (btn) {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal(catalogModal);
      });
    }
  });
  if (closeCatalogBtn) {
    closeCatalogBtn.addEventListener('click', () => closeModal(catalogModal));
  }
  // Bind video triggers
  const videoTriggers = [playVideoBtn, officeShowcase];
  videoTriggers.forEach(trigger => {
    if (trigger) {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openModal(videoModal);
        
        // Start load and play sequence for video loop
        if (showcaseVideo) {
          showcaseVideo.load();
          showcaseVideo.play().then(() => {
            videoWrapper.classList.add('loaded');
          }).catch(err => {
            console.log("Autoplay blocked or load failed:", err);
          });
        }
      });
    }
  });
  if (closeVideoBtn) {
    closeVideoBtn.addEventListener('click', () => {
      closeModal(videoModal);
      if (showcaseVideo) {
        showcaseVideo.pause();
        videoWrapper.classList.remove('loaded');
      }
    });
  }
  // Close modals on clicking overlay backdrop
  [catalogModal, videoModal].forEach(modal => {
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal(modal);
          if (modal === videoModal && showcaseVideo) {
            showcaseVideo.pause();
            videoWrapper.classList.remove('loaded');
          }
        }
      });
    }
  });
  // Close modals on Escape keypress
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (catalogModal.classList.contains('active')) closeModal(catalogModal);
      if (videoModal.classList.contains('active')) {
        closeModal(videoModal);
        if (showcaseVideo) {
          showcaseVideo.pause();
          videoWrapper.classList.remove('loaded');
        }
      }
    }
  });
  // ==========================================
  // 8. CLIENT-SIDE CATALOG TAB FILTERING
  // ==========================================
  const filterTabs = document.querySelectorAll('.filter-tab');
  const catalogItems = document.querySelectorAll('.catalog-item-card');
  filterTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Toggle active states
      filterTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const filterVal = tab.getAttribute('data-filter');
      catalogItems.forEach(item => {
        const itemCategories = item.getAttribute('data-category').split(' ');
        if (filterVal === 'all' || itemCategories.includes(filterVal)) {
          // Smooth fade-in sequence
          item.classList.remove('hidden');
          setTimeout(() => {
            item.style.opacity = '1';
            item.style.transform = 'scale(1)';
          }, 50);
        } else {
          // Smooth fade-out sequence
          item.style.opacity = '0';
          item.style.transform = 'scale(0.9)';
          setTimeout(() => {
            item.classList.add('hidden');
          }, 300);
        }
      });
      
      // Update cursor listener because of DOM changes
      setTimeout(updateCursorHoverEvents, 350);
    });
  });
  // ==========================================
  // 9. PREMIUM CONTACT FORM VALIDATION
  // ==========================================
  const contactForm = document.getElementById('contactForm');
  const formName = document.getElementById('formName');
  const formPhone = document.getElementById('formPhone');
  const submitBtn = document.getElementById('submitBtn');
  function validateInput(input) {
    if (!input) return false;
    let isValid = true;
    // Check custom bounds
    if (input.id === 'formName') {
      isValid = input.value.trim().length >= 2;
    } else if (input.id === 'formPhone') {
      // Basic international phone regex or 10-digit standard
      const phoneRegex = /^[+]?[0-9\s\-()]{7,18}$/;
      isValid = phoneRegex.test(input.value.trim());
    }
    if (isValid) {
      input.classList.remove('invalid');
    } else {
      input.classList.add('invalid');
    }
    return isValid;
  }
  // Clear invalid states on keystroke input
  [formName, formPhone].forEach(input => {
    if (input) {
      input.addEventListener('input', () => {
        if (input.classList.contains('invalid')) {
          validateInput(input);
        }
      });
      // Validate on blur out
      input.addEventListener('blur', () => {
        if (input.value.trim() !== "") {
          validateInput(input);
        }
      });
    }
  });
  if (contactForm) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const isNameValid = validateInput(formName);
      const isPhoneValid = validateInput(formPhone);
      if (isNameValid && isPhoneValid) {
        // Disable submission actions during loading
        submitBtn.disabled = true;
        
        // Dynamic loading visual representation
        const originalText = submitBtn.querySelector('.btn-text').textContent;
        const loadingText = currentLang === 'ru' ? 'Отправка...' : 'Sending...';
        submitBtn.querySelector('.btn-text').textContent = loadingText;
        // Simulate seamless server delivery
        setTimeout(() => {
          // Success State Micro-animations
          submitBtn.classList.add('success');
          
          // Toast notifications or custom alerts
          const successAlert = document.createElement('div');
          successAlert.className = 'glass-panel';
          successAlert.style.position = 'fixed';
          successAlert.style.bottom = '30px';
          successAlert.style.right = '30px';
          successAlert.style.padding = '20px 30px';
          successAlert.style.zIndex = '9999';
          successAlert.style.borderLeft = '4px solid var(--color-primary)';
          successAlert.style.animation = 'slideInToast 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards';
          
          const alertTitle = currentLang === 'ru' ? 'Заявка отправлена!' : 'Request Sent!';
          const alertBody = currentLang === 'ru' ? 'Мы свяжемся с вами в течение 15 минут.' : 'We will reach out to you within 15 minutes.';
          
          successAlert.innerHTML = `
            <h4 style="font-family: var(--font-header); font-size: 1.15rem; margin-bottom: 4px; color: var(--color-text-primary);">${alertTitle}</h4>
            <p style="font-size: 0.85rem; color: var(--color-text-secondary);">${alertBody}</p>
          `;
          
          // Toast reveal keyframe style injector
          const style = document.createElement('style');
          style.innerHTML = `
            @keyframes slideInToast {
              0% { transform: translateY(50px); opacity: 0; }
              100% { transform: translateY(0); opacity: 1; }
            }
          `;
          document.head.appendChild(style);
          document.body.appendChild(successAlert);
          // Reset Form decks
          contactForm.reset();
          
          // Clear styles after 4 seconds
          setTimeout(() => {
            submitBtn.classList.remove('success');
            submitBtn.disabled = false;
            submitBtn.querySelector('.btn-text').textContent = originalText;
            
            // Fade out alert toast
            successAlert.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            successAlert.style.opacity = '0';
            successAlert.style.transform = 'translateY(20px)';
            setTimeout(() => {
              successAlert.remove();
            }, 500);
          }, 4000);
        }, 1500);
      }
    });
  }
});
